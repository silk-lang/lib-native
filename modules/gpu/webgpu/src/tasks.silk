const HOST_OS: string<'static> = Intrinsic.targetOperatingSystem()
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import task_shaders as Shaders
import silk.text.string { String }
import silk.text.format { Format, ParseError }
import silk.core.result { Result }
import task_browser as Browser
import task_build as Build
import task_schema as Schema
import task_schema_browser as BrowserSchema
import silk.core.option { Option }
import silk.system.filesystem { Path }
import task_bench as Bench
import task_bench_build as BenchBuild
import task_data as D
import task_pixels as Pixels
import task_process as Process
import task_schema_source as Source
import task_tests as Tests
static if Intrinsic.targetOperatingSystem() == "linux" { import task_window as WindowProof }

union Tasks {
  EmbedShaders { pub check: bool },
  RectShader { pub check: bool },
  InstallWebgpu,
  SetupCi { pub browser: bool },
  TestHost,
  TestBrowser { pub wasm: String, pub fixtures: String, pub chromium: String, pub timeout: u64 },
  Generate { pub check: bool },
  GenerateBrowser { pub check: bool, pub exportsOutput: String },
  SchemaSource,
  Bench { pub build: bool, pub buildOnly: bool, pub silk: String, pub c: String, pub rust: String, pub n: u64, pub benchFrames: u64, pub benchRepeats: usize, pub benchOutput: String, pub baseline: String, pub recordBaseline: bool },
  BenchCompare { pub old: String, pub new: String },
  Ab { pub old: String, pub new: String, pub n: u64, pub abFrames: u64, pub abRepeats: usize, pub abOutput: String },
  Window { pub release: bool, pub buildOnly: bool },
  TestWindow { pub windowOutput: String },
  TestAbi,
  TestNative,
  TestPixels { pub binary: String, pub actual: String, pub pixelOutput: String, pub pixelTimeout: String },
  PixelHarnessTests,
  RegeneratePixels,
  Check { pub skipNative: bool, pub browser: bool },
  BuildPackage { pub package: String, pub target: String, pub release: bool },
}
impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "WebGPU maintenance tasks")
      |> Command.variant("EmbedShaders", "Embed canonical WGSL in Silk byte literals")
      |> Command.variant("RectShader", "Generate the C benchmark's WGSL string")
      |> Command.variant("InstallWebgpu", "Install checksum-pinned Dawn through the repository task")
      |> Command.variant("SetupCi", "Provision the documented Linux GPU or browser runner")
      |> Command.variant("TestHost", "Run the JavaScript browser-runtime contract tests")
      |> Command.variant("TestBrowser", "Run real wasm samples and canvas presentation in installed Chromium")
      |> Command.option("wasm", Opt.about("Use an already compiled wasm sample binary"))
      |> Command.option("fixtures", Opt.about("Pixel fixture manifest; defaults to browser/fixtures.json"))
      |> Command.option("chromium", Opt.about("Installed Chromium executable"))
      |> Command.option("timeout", Opt.about("Per-sample timeout in milliseconds") |> Opt.default("30000"))
      |> Command.variant("Generate", "Generate raw bindings and C/Silk ABI probes from the pinned schema")
      |> Command.variant("GenerateBrowser", "Generate browser layouts, enums, methods and callback exports")
      |> Command.option("exportsOutput", Opt.about("Also publish forwarding exports to a consumer root module"))
      |> Command.option("check", Opt.about("Fail if generated bytes differ, without writing"))
      |> Command.option("browser", Opt.about("Provision browser prerequisites instead of lavapipe"))
      |> Command.variant("SchemaSource", "Fetch and verify every pinned upstream schema input; print its cache directory")
      |> Command.variant("Bench", "Build and measure the checked Silk/C/Rust benchmark matrix")
      |> Command.variant("BenchCompare", "Compare two recorded CPU benchmark result files")
      |> Command.variant("Ab", "Compare two marked binaries using scoped Callgrind instruction counts")
      |> Command.variant("Window", "Build and run the real GLFW WebGPU window sample")
      |> Command.variant("TestWindow", "Prove Linux X11 presentation, resize and Escape close using compositor pixels")
      |> Command.variant("TestAbi", "Build and run raw ABI layout and symbol assertions")
      |> Command.variant("TestNative", "Build and run native lifetime/readback/validation scenarios")
      |> Command.variant("TestPixels", "Run native samples or check an existing raw-output directory")
      |> Command.variant("PixelHarnessTests", "Test the independent CPU pixel oracle and its gates")
      |> Command.variant("RegeneratePixels", "Regenerate committed PNGs from the independent CPU oracle")
      |> Command.variant("Check", "Check generators, CPU oracle, packages and optionally native/browser execution")
      |> Command.option("build", Opt.about("Build all three benchmark implementations before measurement"))
      |> Command.option("buildOnly", Opt.about("Build without executing"))
      |> Command.option("silk", Opt.about("Silk benchmark executable; defaults to .cache/bench/silk"))
      |> Command.option("c", Opt.about("C benchmark executable; defaults to .cache/bench/c"))
      |> Command.option("rust", Opt.about("Rust benchmark executable; defaults to .cache/bench/rust"))
      |> Command.option("n", Opt.about("Draw/write/bind workload size") |> Opt.default("10000"))
      |> Command.option("benchFrames", Opt.about("Measured frames per run") |> Opt.long("frames") |> Opt.default("10"))
      |> Command.option("benchRepeats", Opt.about("Interleaved repetitions") |> Opt.long("repeats") |> Opt.default("5"))
      |> Command.option("benchOutput", Opt.about("CPU measurement JSON; defaults to .cache/bench/results.json") |> Opt.long("output"))
      |> Command.option("baseline", Opt.about("Measured baseline JSON; defaults to bench/results/baseline.json"))
      |> Command.option("recordBaseline", Opt.about("Replace the baseline after a successful checked measurement"))
      |> Command.arg("old", Opt.about("Previous binary or recorded result") |> Opt.required())
      |> Command.arg("new", Opt.about("New binary or recorded result") |> Opt.required())
      |> Command.option("abFrames", Opt.about("Measured frames per Callgrind run") |> Opt.long("frames") |> Opt.default("3"))
      |> Command.option("abRepeats", Opt.about("Callgrind repetitions") |> Opt.long("repeats") |> Opt.default("3"))
      |> Command.option("abOutput", Opt.about("Callgrind output directory; defaults to .cache/bench/ab") |> Opt.long("output"))
      |> Command.option("release", Opt.about("Build the window sample in release mode"))
      |> Command.option("windowOutput", Opt.about("X11 proof output directory; defaults to .cache/pixels/window") |> Opt.long("output"))
      |> Command.option("binary", Opt.about("Run an already compiled native sample executable"))
      |> Command.option("actual", Opt.about("Check an existing directory without running a binary"))
      |> Command.option("pixelOutput", Opt.about("Native sample output directory; defaults to .cache/pixels/native") |> Opt.long("output"))
      |> Command.option("pixelTimeout", Opt.about("Native sample timeout in seconds") |> Opt.long("timeout") |> Opt.default("120"))
      |> Command.option("skipNative", Opt.about("Run only generator, CPU oracle and package checks"))
      |> Command.variant("BuildPackage", "Build an owned executable and print its artifact path")
      |> Command.arg("package", Opt.about("examples, examples-window, sys/abi, tests/native or bench") |> Opt.required())
      |> Command.option("target", Opt.about("Native host (default) or wasm32-unknown-unknown"))
  }
}
impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.BuildPackage { package, target, release } => {
        let name = if String.view(&package) == "examples" { "gpu-webgpu-examples" }
          else if String.view(&package) == "examples-window" { "gpu-webgpu-examples-window" }
          else if String.view(&package) == "sys/abi" { "gpu-webgpu-abi" }
          else if String.view(&package) == "tests/native" { "gpu-webgpu-tests-native" }
          else if String.view(&package) == "bench" { "gpu-webgpu-bench" }
          else { run Task.abort("build-package requires an owned executable package") }
        if String.view(&target) != "" && String.view(&target) != Build.target() && String.view(&target) != "wasm32-unknown-unknown" { run Task.abort("build-package supports the current native host or wasm32-unknown-unknown") }
        let manifest = run D.format("{}/silk.toml", &.(String.view(&package)))
        let relative = run D.format("modules/gpu/webgpu/{}", &.(String.view(&package)))
        let binary = run Build.build(String.view(&manifest), name, String.view(&relative), release, String.view(&target) == "wasm32-unknown-unknown")
        run D.print(String.view(&binary))
      }
      Tasks.EmbedShaders { check } => run Shaders.embed(check)
      Tasks.RectShader { check } => run Shaders.rect(check)
      Tasks.Generate { check } => run Schema.generate(check)
      Tasks.GenerateBrowser { check, exportsOutput } => run BrowserSchema.generate(check, String.view(&exportsOutput))
      Tasks.TestHost => { let root = run Task.root()
        run Process.exec("node", &["--test", "browser/host.test.mjs"], &[], &root) }
      Tasks.SchemaSource => {
        let _source = run Source.fetch()
        let lock = run D.load("scripts/schema-lock.json")
        let revision = run D.requiredString(run D.field(&lock, "revision"))
        let relative = run D.format(".cache/webgpu-headers/{}", &.(revision))
        let directory = run Process.resolve(String.view(&relative))
        run D.print(Process.text(&directory))
      }
      Tasks.Bench { build, buildOnly, silk, c, rust, n, benchFrames, benchRepeats, benchOutput, baseline, recordBaseline } => {
        run Bench.validate(n, benchFrames, benchRepeats)
        if build || buildOnly { run BenchBuild.build() }
        if !buildOnly {
          let options = [move silk, move c, move rust]
          let names = ["silk", "c", "rust"]
          let mut binaries = [String.make(), String.make(), String.make()]
          let mut index: usize = 0
          while index < names.length {
            let fallback = run D.format(".cache/bench/{}{}", &(names[index], if HOST_OS == "windows" { ".exe" } else { "" }))
            binaries[index] = run Process.pathOption(String.view(&options[index]), String.view(&fallback))
            index = index + 1
          }
          let output = run Process.pathOption(String.view(&benchOutput), ".cache/bench/results.json")
          let previous = run Process.pathOption(String.view(&baseline), "bench/results/baseline.json")
          run Bench.measure(&binaries, n, benchFrames, benchRepeats, String.view(&output), String.view(&previous), recordBaseline)
        }
      }
      Tasks.BenchCompare { old, new } => {
        let before = run Process.pathOption(String.view(&old), "")
        let after = run Process.pathOption(String.view(&new), "")
        run Bench.compareFiles(String.view(&before), String.view(&after))
      }
      Tasks.Ab { old, new, n, abFrames, abRepeats, abOutput } => {
        let before = run Process.pathOption(String.view(&old), "")
        let after = run Process.pathOption(String.view(&new), "")
        let output = run Process.pathOption(String.view(&abOutput), ".cache/bench/ab")
        run Bench.ab(String.view(&before), String.view(&after), n, abFrames, abRepeats, String.view(&output))
      }
      Tasks.Window { release, buildOnly } => {
        let binary = run Build.build("examples-window/silk.toml", "gpu-webgpu-examples-window", "modules/gpu/webgpu/examples-window", release, false)
        if buildOnly { run D.print(String.view(&binary)) }
        else { let executable = run Process.resolve(String.view(&binary))
          run Task.exec(Path.view(&executable) |> Option<string>.unwrapOr(""), &[]) }
      }
      Tasks.TestWindow { windowOutput } => {
        static if Intrinsic.targetOperatingSystem() == "linux" { let output = run Process.pathOption(String.view(&windowOutput), ".cache/pixels/window")
          run WindowProof.test(String.view(&output)) }
        else { run Task.abort("test-window requires Linux X11, Xvfb and pinned lavapipe") }
      }
      Tasks.TestAbi => run Tests.abi()
      Tasks.TestNative => run Tests.native()
      Tasks.TestPixels { binary, actual, pixelOutput, pixelTimeout } => {
        let executable = run Process.pathOption(String.view(&binary), "")
        let directory = run Process.pathOption(String.view(&actual), "")
        let output = run Process.pathOption(String.view(&pixelOutput), ".cache/pixels/native")
        let timeout = match move Format.f64Value(String.view(&pixelTimeout)) {
          Result<f64, ParseError>.Success { value } => value
          Result<f64, ParseError>.Failure { .. } => run Task.abort("--timeout must be a number of seconds")
        }
        run Tests.pixels(String.view(&executable), String.view(&directory), String.view(&output), timeout)
      }
      Tasks.PixelHarnessTests => run Pixels.tests()
      Tasks.RegeneratePixels => run Pixels.regenerate()
      Tasks.Check { skipNative, browser } => {
        run Tests.checks(skipNative)
        if browser { run Task.silk(&["task", "test-browser"]) }
      }
      Tasks.TestBrowser { wasm, fixtures, chromium, timeout } => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          run Task.abort("Windows browser tasks are unsupported: Silk dev.64 lacks managed subprocesses (silk#3034)")
        } else {
          let root = run Task.root()
          run Process.timed("node", &["--test", "browser/host.test.mjs"], &root, 60000)
          let binary = if String.view(&wasm) == "" {
            run Build.build("examples/silk.toml", "gpu-webgpu-examples", "modules/gpu/webgpu/examples", false, true)
          } else { run Process.pathOption(String.view(&wasm), "") }
          if timeout == 0 { run Task.abort("browser timeout must be positive") }
          let manifest = run Process.pathOption(String.view(&fixtures), "browser/fixtures.json")
          let executable = run Process.pathOption(String.view(&chromium), "")
          run Browser.test(String.view(&binary), String.view(&manifest), String.view(&executable), timeout)
        }
      }
      Tasks.InstallWebgpu => run Task.silk(&["task", "--manifest-path", "../../../silk.toml", "install-webgpu"])
      Tasks.SetupCi { browser } => {
        if browser { run Task.silk(&["task", "--manifest-path", "../../../silk.toml", "setup-ci", "--browser"]) }
        else { run Task.silk(&["task", "--manifest-path", "../../../silk.toml", "setup-ci", "--linux-gpu"]) }
      }
    }
  }
}
pub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }
