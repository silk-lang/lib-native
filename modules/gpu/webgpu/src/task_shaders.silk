import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { InvalidUtf8, ScalarStep, String }
import silk.text.char as Char
import silk.num.u32
import silk.num.usize

// Match Python json.dumps' ASCII string spelling, including surrogate pairs.
effect fn hex(output: &mut Bytes, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let escaped: [u8; 6] = [92, 117, digits[u32.toUsize(value / 4096 % 16)], digits[u32.toUsize(value / 256 % 16)], digits[u32.toUsize(value / 16 % 16)], digits[u32.toUsize(value % 16)]]
  run Bytes.append(&mut output, &escaped)
}

pub effect fn quoted(output: &mut Bytes, source: &[u8]) -> () ! TaskError | OutOfMemoryError ? &mut Allocator {
  let text = match move String.fromUtf8(source) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => run Task.abort("shader is not UTF-8")
  }
  run Bytes.append(&mut output, b"\"")
  let mut cursor = String.scalarCursor()
  while true {
    let step = match move String.nextScalar(text, move cursor) {
      Option<ScalarStep>.Some { value } => move value
      Option<ScalarStep>.None => { break }
    }
    let scalar = Char.toU32(String.scalarValue(&step))
    let offset = String.scalarByteOffset(&step)
    cursor = String.nextCursor(move step)
    if scalar == 34 { run Bytes.append(&mut output, b"\\\"") }
    else if scalar == 92 { run Bytes.append(&mut output, b"\\\\") }
    else if scalar == 8 { run Bytes.append(&mut output, b"\\b") }
    else if scalar == 12 { run Bytes.append(&mut output, b"\\f") }
    else if scalar == 10 { run Bytes.append(&mut output, b"\\n") }
    else if scalar == 13 { run Bytes.append(&mut output, b"\\r") }
    else if scalar == 9 { run Bytes.append(&mut output, b"\\t") }
    else if scalar < 32 || scalar > 126 {
      if scalar <= 65535 { run hex(&mut output, scalar) }
      else {
        run hex(&mut output, 55296 + (scalar - 65536) / 1024)
        run hex(&mut output, 56320 + (scalar - 65536) % 1024)
      }
    } else { run Bytes.append(&mut output, Slice.view<u8>(source, offset, 1)) }
  }
  run Bytes.append(&mut output, b"\"")
}

effect fn normalized(source: Bytes) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let input = Bytes.asSlice(&source)
  let mut index: usize = 0
  while index < input.length && input[index] != 13 { index = index + 1 }
  if index == input.length { drop input
    return move source }
  let mut result = run Bytes.makeWithCapacity(input.length)
  run Bytes.append(&mut result, Slice.view<u8>(input, 0, index))
  while index < input.length {
    if input[index] == 13 {
      run Bytes.append(&mut result, b"\n")
      if index + 1 < input.length && input[index + 1] == 10 { index = index + 1 }
    } else { run Bytes.append(&mut result, Slice.view<u8>(input, index, 1)) }
    index = index + 1
  }
  return move result
}

pub effect fn publish(path: &Path, contents: &[u8], check: bool) -> ()
  ! TaskError | FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem {
  if check {
    if !run FileSystem.exists(path) { run Task.abort("generated output is missing") }
    let previous = run normalized(run FileSystem.readFile(path))
    let bytes = Bytes.asSlice(&previous)
    if bytes.length != contents.length { run Task.abort("generated output is stale") }
    let mut index: usize = 0
    while index < bytes.length {
      if bytes[index] != contents[index] { run Task.abort("generated output is stale") }
      index = index + 1
    }
  } else { run FileSystem.writeFileWithParents(path, contents) }
}

pub effect fn embed(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let names = ["clear", "triangle", "textured-quad", "instanced-rects", "compute", "msaa"]
  let functions = ["clear", "triangle", "textured_quad", "instanced_rects", "compute", "msaa"]
  let mut output = run Bytes.copy(b"// Generated by silk task embed-shaders from modules/gpu/webgpu/examples/shaders; do not edit.\n")
  let mut index: usize = 0
  while index < names.length {
    let mut relative = run String.copy("examples/shaders/")
    run String.append(&mut relative, names[index])
    run String.append(&mut relative, ".wgsl")
    let path = run Path.join(&root, String.view(&relative))
    let source = run normalized(run FileSystem.readFile(&path))
    run Bytes.append(&mut output, b"pub fn ")
    run Bytes.append(&mut output, String.utf8Bytes(functions[index]))
    run Bytes.append(&mut output, b"() -> &'static [u8] { return b")
    run quoted(&mut output, Bytes.asSlice(&source))
    run Bytes.append(&mut output, b" }\n")
    index = index + 1
  }
  let destination = run Path.join(&root, "examples/src/generated_shaders.silk")
  run publish(&destination, Bytes.asSlice(&output), check)
}

pub effect fn rect(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let sourcePath = run Path.join(&root, "examples/shaders/instanced-rects.wgsl")
  let source = run normalized(run FileSystem.readFile(&sourcePath))
  let mut output = run Bytes.copy(b"static const char rect_shader[] = ")
  run quoted(&mut output, Bytes.asSlice(&source))
  run Bytes.append(&mut output, b";\n")
  let destination = run Path.join(&root, "bench/rect_shader.h")
  run publish(&destination, Bytes.asSlice(&output), check)
}
