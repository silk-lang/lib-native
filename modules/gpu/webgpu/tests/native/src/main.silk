import webgpu_sys.generated_webgpu as sys
import webgpu.runtime { Instance, RequestAdapterOptions, GpuError }
import webgpu.runtime as runtime
import webgpu.capabilities as capabilities
import webgpu.descriptors {
  DeviceDescriptor,
  BufferDescriptor,
  ComputeState,
  ComputePipelineDescriptor,
  ComputePassDescriptor,
  ColorTargetState,
  FragmentState,
  Extent3D,
  Limits,
  RenderPipelineDescriptor,
  TexelCopyBufferInfo,
  TexelCopyBufferLayout,
  TexelCopyTextureInfo,
  VertexState
}
import webgpu.resources as gpu
import webgpu.shared_texture as shared
import webgpu.shared_texture { BeginAccess, SharedFence, SharedImage, SharedTextureMemory }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer }
import silk.io.writer_native { StdoutWriter, StderrWriter }

fn writeMessage(message: &[u8], error: bool) -> () {
  if error {
    let mut writer = StderrWriter.make()
    drop run Effect.result(Writer.writeAll(message) |> Effect.provideMut<Writer>(&mut writer))
  } else {
    let mut writer = StdoutWriter.make()
    drop run Effect.result(Writer.writeAll(message) |> Effect.provideMut<Writer>(&mut writer))
  }
}

fn rawInstanceSmoke() -> bool {
  let instance = unsafe sys.wgpuCreateInstance(Pointer.null<sys.WGPUInstanceDescriptor>())
  if Pointer.isNull(instance) {
    return false
  }
  unsafe sys.wgpuInstanceProcessEvents(instance)
  unsafe sys.wgpuInstanceRelease(instance)
  return true
}

effect fn scenarios(instance: &Instance) -> ()
  ! GpuError | OutOfMemoryError {
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.default())

  // Failed creation also owns a deferred device-lost callback. Its mailbox must
  // survive the failed request and be drained before this later event pump.
  let mut impossibleLimits = Limits.default()
  impossibleLimits.setMaxTextureDimension2D(0xfffffffe)
  let rejectedDescriptor = DeviceDescriptor.default().withRequiredLimits(&impossibleLimits)
  match move run Effect.result(adapter.requestDevice(&rejectedDescriptor)) {
    Result<runtime.Device, GpuError | OutOfMemoryError>.Success { .. } => {
      fail GpuError.status(0xffff0006)
    }
    Result<runtime.Device, GpuError | OutOfMemoryError>.Failure { error } => {
      match move error {
        GpuError rejected => {
          if rejected.code != sys.WGPURequestDeviceStatus_Error {
            fail move rejected
          }
        }
        OutOfMemoryError allocation => {
          fail move allocation
        }
      }
    }
  }
  instance.processEvents()
  let device = run adapter.requestDevice(&DeviceDescriptor.default())

  // Strict arithmetic must not silently fall back on an ordinary device.
  match move run Effect.result(
    gpu.createShaderModuleStrict(
      &device,
      b"strict without feature",
      b"@compute @workgroup_size(1) fn main() {}",
    ),
  ) {
    Result<gpu.ShaderModule, GpuError>.Success { .. } => {
      fail GpuError.status(0xffff000b)
    }
    Result<gpu.ShaderModule, GpuError>.Failure { error } => {
      if error.code != gpu.STRICT_MATH_UNAVAILABLE {
        fail move error
      }
    }
  }
  let available = capabilities.instanceFeatures()
  let instanceLimits = run capabilities.instanceLimits()
  if !available.has(sys.WGPUInstanceFeatureName_TimedWaitAny)
    || instanceLimits.timedWaitAnyMaxCount() < 1 {
    fail GpuError.status(0xffff0007)
  }
  let adapterInfo = run adapter.getInfo()
  let deviceInfo = run device.getAdapterInfo()
  if adapterInfo.vendorID() != deviceInfo.vendorID()
    || adapterInfo.deviceID() != deviceInfo.deviceID() {
    fail GpuError.status(0xffff0008)
  }
  let adapterLimits = run adapter.getLimits()
  let deviceLimits = run device.getLimits()
  if deviceLimits.maxBufferSize() < 16
    || deviceLimits.maxBufferSize() > adapterLimits.maxBufferSize() {
    fail GpuError.status(0xffff0009)
  }
  let supported = adapter.getFeatures()
  let enabled = device.getFeatures()
  let enabledValues = enabled.features()
  let mut featureIndex: usize = 0
  while featureIndex < enabledValues.length {
    let feature = enabledValues[featureIndex]
    if !supported.has(feature) || !device.hasFeature(feature) {
      fail GpuError.status(0xffff000a)
    }
    featureIndex = featureIndex + 1
  }
  let queue = run gpu.getQueue(&device)
  let upload = run gpu.createBuffer(
    &device,
    &BufferDescriptor.make(
      b"upload",
      16,
      sys.WGPUBufferUsage_CopySrc | sys.WGPUBufferUsage_MapWrite,
      false,
    ),
  )
  let readback = run gpu.createBuffer(
    &device,
    &BufferDescriptor.make(
      b"readback",
      16,
      sys.WGPUBufferUsage_CopyDst | sys.WGPUBufferUsage_MapRead,
      false,
    ),
  )
  let expected: [u8; 16] = [0, 1, 2, 3, 4, 5, 6, 7, 248, 249, 250, 251, 252, 253, 254, 255]
  let mapped = run runtime.mapAsync(&device, &upload, sys.WGPUMapMode_Write, 0, 16)
  run mapped.write(0, &expected)
  drop mapped
  let mut encoder = run gpu.createCommandEncoder(&device, b"copy")
  encoder.copyBufferToBuffer(&upload, 0, &readback, 0, 16)
  let commands = run encoder.finish(b"copy")
  queue.submit(&[commands.reference()])
  let bytes = run runtime.mapRead(&device, &readback, 0, 16)
  let actual = bytes.asSlice()
  if actual.length != expected.length {
    fail GpuError.status(0xffff0001)
  }
  let mut at: usize = 0
  while at < expected.length {
    if actual[at] != expected[at] {
      fail GpuError.status(0xffff0002)
    }
    at = at + 1
  }
  run runtime.onSubmittedWorkDone(&device, &queue)

  let shader = run gpu.createShaderModule(
    &device,
    b"async pipeline",
    b"@compute @workgroup_size(1) fn main() {}",
  )
  let messages = run runtime.getCompilationInfo(&device, &shader)
  if messages.length() != 0 {
    fail GpuError.status(0xffff0004)
  }
  let compute = ComputeState.default().withModule(&shader).withEntryPoint(b"main")
  let pipelineDescriptor = ComputePipelineDescriptor.default().withCompute(compute)
  let pipeline = run runtime.createComputePipelineAsync(&device, &pipelineDescriptor)
  let mut computeEncoder = run gpu.createCommandEncoder(&device, b"async pipeline dispatch")
  let mut pass = run computeEncoder.beginComputePass(&ComputePassDescriptor.default())
  pass.setPipeline(&pipeline)
  pass.dispatchWorkgroups(1, 1, 1)
  pass.end()
  let computeCommands = run computeEncoder.finish(b"async pipeline dispatch")
  queue.submit(&[computeCommands.reference()])
  run runtime.onSubmittedWorkDone(&device, &queue)

  // Async pipeline validation is a typed completion, not an uncaptured device error.
  let missingEntry = ComputeState.default().withModule(&shader).withEntryPoint(b"missing")
  let invalidPipeline = ComputePipelineDescriptor.default().withCompute(missingEntry)
  match move run Effect.result(runtime.createComputePipelineAsync(&device, &invalidPipeline)) {
    Result<gpu.ComputePipeline, GpuError | OutOfMemoryError>.Success { .. } => {
      fail GpuError.status(0xffff0005)
    }
    Result<gpu.ComputePipeline, GpuError | OutOfMemoryError>.Failure { error } => {
      match move error {
        GpuError validation => {
          if validation.code != sys.WGPUCreatePipelineAsyncStatus_ValidationError {
            fail move validation
          }
        }
        OutOfMemoryError allocation => {
          fail move allocation
        }
      }
    }
  }

  // A validation failure must be returned through the scope, never uncaptured or trapped.
  device.pushErrorScope(sys.WGPUErrorFilter_Validation)
  let invalid = run gpu.createBuffer(
    &device,
    &BufferDescriptor.make(b"invalid usage", 16, 0, false),
  )
  let scope = run Effect.result(device.popErrorScope())
  match move scope {
    Result<(), GpuError | OutOfMemoryError>.Success { .. } => {
      fail GpuError.status(0xffff0003)
    }
    Result<(), GpuError | OutOfMemoryError>.Failure { error } => {
      match move error {
        GpuError validation => {
          if validation.code != sys.WGPUErrorType_Validation {
            fail move validation
          }
        }
        OutOfMemoryError allocation => {
          fail move allocation
        }
      }
    }
  }
  drop invalid
  run device.checkErrors()

  // Dropping an unfinished request must drain or cancel before its result slot is freed.
  let pending = run instance.requestAdapterStart(&RequestAdapterOptions.default())
  drop pending
  let duplicate = readback.dup()
  drop duplicate
}

/// Makes a render pipeline on a device that keeps Dawn's cache in `directory`, started then
/// waited for, as renderers do to compile pipelines side by side.
effect fn cachedPipeline(instance: &Instance, directory: &[u8]) -> ()
  ! GpuError | OutOfMemoryError {
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.default())
  let device = run adapter.requestDevice(&DeviceDescriptor.cachedIn(directory))
  let shader = run gpu.createShaderModule(
    &device,
    b"cached pipeline",
    b"@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f { return vec4f(f32(i), 0.0, 0.0, 1.0); }\n@fragment fn fs() -> @location(0) vec4f { return vec4f(1.0, 0.5, 0.25, 1.0); }",
  )
  let mut target = ColorTargetState.default()
  target.setFormat(sys.WGPUTextureFormat_RGBA8Unorm)
  target.setWriteMask(sys.WGPUColorWriteMask_All)
  let targets = [target]
  let vertex = VertexState.default().withModule(&shader).withEntryPoint(b"vs")
  let fragment = FragmentState.default().withModule(&shader).withEntryPoint(b"fs").withTargets(&targets)
  let descriptor = RenderPipelineDescriptor.default().withVertex(vertex).withFragment(&fragment)
  let mut request = run runtime.createRenderPipelineStart(&device, &descriptor)
  run request.wait()
  drop run request.finish()
  run device.checkErrors()
}

/// Two devices of one adapter share one image: the first writes it and ends its access, the
/// second waits for the fences of that access and reads the pixels back. Returns false where the
/// adapter cannot share (then nothing is checked).
effect fn sharedImage(instance: &Instance) -> bool
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.default())
  let features = SharedImage.features()
  if features.length == 0 {
    return false
  }
  let mut at: usize = 0
  while at < features.length {
    if !adapter.hasFeature(features[at]) {
      return false
    }
    at = at + 1
  }
  let descriptor = DeviceDescriptor.default().withRequiredFeatures(features)
  let producer = run adapter.requestDevice(&descriptor)
  // An adapter makes one device; the second device comes from a second request for the same
  // adapter.
  let second = run instance.requestAdapter(&RequestAdapterOptions.default())
  let consumer = run second.requestDevice(&descriptor)
  if !SharedImage.supported(&producer) || !SharedImage.supported(&consumer) {
    fail GpuError.status(0xffff0020)
  }
  let image = run SharedImage.create(4, 2)
  // A new image is the process's own: nothing else reads it yet, and a layer can show it.
  if image.inUse() || Pointer.isNull(unsafe image.ioSurface()) {
    fail GpuError.status(0xffff0027)
  }
  let written = run SharedTextureMemory.importImage(&producer, b"shared (producer)", &image)
  let shown = run SharedTextureMemory.importImage(&consumer, b"shared (consumer)", &image)
  let properties = run shown.properties()
  if properties.width != 4 || properties.height != 2
    || properties.format != sys.WGPUTextureFormat_BGRA8Unorm {
    fail GpuError.status(0xffff0021)
  }
  let target = run written.createTexture(b"shared target")
  let source = run shown.createTexture(b"shared source")

  let mut pixels: [u8; 32] = [0; 32]
  at = 0
  while at < 32 {
    pixels[at] = usize.toU8(at * 7 + 3)
    at = at + 1
  }
  let mut size = Extent3D.default()
  size.setWidth(4)
  size.setHeight(2)
  size.setDepthOrArrayLayers(1)
  let mut layout = TexelCopyBufferLayout.default()
  layout.setBytesPerRow(256)
  layout.setRowsPerImage(2)

  let mut first = BeginAccess.ready()
  first.initialized = false
  run written.beginAccess(&target, first)
  let producerQueue = run gpu.getQueue(&producer)
  let mut tight = TexelCopyBufferLayout.default()
  tight.setBytesPerRow(16)
  tight.setRowsPerImage(2)
  producerQueue.writeTexture(
    &TexelCopyTextureInfo.default().withTexture(&target),
    &pixels,
    &tight,
    &size,
  )
  let end = run written.endAccess(&target, false)
  if !end.initialized {
    fail GpuError.status(0xffff0022)
  }
  run producer.checkErrors()

  // The fences can be asked without waiting, and reach their values once the write ran.
  let fences = end.fences.asSlice()
  let values = end.signaledValues.asSlice()
  let mut spins: u32 = 0
  at = 0
  while at < fences.length {
    let state = fences[at].poll(values[at])
    if state == shared.FENCE_UNKNOWN {
      fail GpuError.status(0xffff0023)
    }
    if state == shared.FENCE_SIGNALED {
      at = at + 1
    } else {
      spins = spins + 1
      if spins > 2000000 {
        fail GpuError.status(0xffff0024)
      }
      instance.processEvents()
    }
  }

  // A fence belongs to the device that made it: the consumer imports its handle.
  let mut imported = List<SharedFence>.make()
  at = 0
  while at < fences.length {
    let info = fences[at].exportInfo()
    if info.kind != shared.FENCE_MTL_SHARED_EVENT {
      fail GpuError.status(0xffff0025)
    }
    run imported.append(run SharedFence.importMtlSharedEvent(&consumer, info.handle))
    at = at + 1
  }
  run shown.beginAccessAfter(&source, BeginAccess.ready(), imported.asSlice(), values)
  let readback = run gpu.createBuffer(
    &consumer,
    &BufferDescriptor.make(
      b"shared readback",
      512,
      sys.WGPUBufferUsage_CopyDst | sys.WGPUBufferUsage_MapRead,
      false,
    ),
  )
  let mut destination = TexelCopyBufferInfo.default().withBuffer(&readback)
  destination.setLayout(layout)
  let mut encoder = run gpu.createCommandEncoder(&consumer, b"shared read")
  encoder.copyTextureToBuffer(
    &TexelCopyTextureInfo.default().withTexture(&source),
    &destination,
    &size,
  )
  let commands = run encoder.finish(b"shared read")
  let consumerQueue = run gpu.getQueue(&consumer)
  consumerQueue.submit(&[commands.reference()])
  drop run shown.endAccess(&source, false)
  let bytes = run runtime.mapRead(&consumer, &readback, 0, 512)
  let actual = bytes.asSlice()
  let mut row: usize = 0
  while row < 2 {
    let mut column: usize = 0
    while column < 16 {
      if actual[row * 256 + column] != pixels[row * 16 + column] {
        fail GpuError.status(0xffff0026)
      }
      column = column + 1
    }
    row = row + 1
  }
  run consumer.checkErrors()

  // Everything shared is released while both devices are alive, and neither device reports an
  // error for it afterwards.
  drop imported
  drop end
  drop source
  drop target
  drop shown
  drop written
  drop image
  instance.processEvents()
  run producer.checkErrors()
  run consumer.checkErrors()
  return true
}

effect fn program() -> i32
  ! GpuError | OutOfMemoryError {
  if !rawInstanceSmoke() {
    return 1
  }
  let instance = run Instance.create()
  let observer = instance.diagnostics()
  run scenarios(&instance)
  // The first device fills the cache, the second reads it back.
  run cachedPipeline(&instance, b"build/gpu-webgpu-cache-test")
  run cachedPipeline(&instance, b"build/gpu-webgpu-cache-test")
  let mut allocator = Allocator.systemAllocatorProvider()
  let sharedChecked = run sharedImage(&instance) |> Effect.provideMut<Allocator>(&mut allocator)
  drop instance
  if observer.liveHandles() != 0 || observer.failureCount() != 0 {
    if observer.liveHandles() != 0 {
      writeMessage(b"FAIL live GPU handles remain\n", true)
    }
    if observer.failureCount() != 0 {
      writeMessage(b"FAIL a device reported an error nothing read\n", true)
    }
    return 2
  }
  if sharedChecked {
    writeMessage(b"PASS two devices share an image, with fences\n", false)
  } else {
    writeMessage(b"SKIP shared image: this adapter cannot share one between devices\n", false)
  }
  let message = b"PASS native instance, mapping, queue completion, validation scope, cancellation, pipeline cache, and handle accounting\n"
  writeMessage(message, false)
  return 0
}

effect fn failed(error: GpuError | OutOfMemoryError) -> i32 {
  match move error {
    GpuError failure => {
      let message = failure.message.asSlice()
      writeMessage(message, true)
      writeMessage(b"\n", true)
    }
    OutOfMemoryError {} => {
      writeMessage(b"GPU test allocation failed\n", true)
    }
  }
  return 1
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
