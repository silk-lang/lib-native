import silk.build.plan { Plan }
import silk.build.step { sourcePath }

static fn plan() -> Plan {
  let mut plan = Plan.empty()
  if Intrinsic.targetOperatingSystem() == "darwin" || Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan
      |> Plan.compileNative(
        "c",
        sourcePath("native/callbacks.c"),
        &["-std=c11", "-O2"],
        &[Plan.archivePath("dawn", "include")],
      )
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib/libwebgpu_dawn.a"))
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkLibrary("c++", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("CoreFoundation", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("Foundation", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("IOSurface", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("QuartzCore", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("Cocoa", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("IOKit", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "darwin" {
    plan = plan |> Plan.linkFramework("Metal", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib64/libwebgpu_dawn.a"))
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("stdc++", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("m", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("dl", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("rt", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "linux" {
    plan = plan |> Plan.linkLibrary("pthread", "dynamic", false, false)
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib/nonstd_dawn.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib/nonstd_callbacks.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib/ucrt.lib"))
  }
  if Intrinsic.targetOperatingSystem() == "windows" {
    plan = plan |> Plan.linkArchive(Plan.archivePath("dawn", "lib/vcruntime.lib"))
  }
  return plan
}

pub const PLAN: Plan = plan()
