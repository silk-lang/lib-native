//! Native-only sample artifact output. Filesystem access is kept out of rendering.
static if Intrinsic.targetArchitecture() != "wasm32" {
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.core.effect { Effect }
  import silk.system.filesystem { FileSystem, Path, FileError }
  import silk.system.filesystem_native { OsFileSystem }
  import silk.system.host_input { HostInput, HostInputError }
  static if Intrinsic.targetOperatingSystem() == "windows" {
    import silk.platform.windows.host_input { WindowsHostInput }
    import silk.collections.slice { Slice }
  } else {
    import silk.system.host_input_native { OsHostInput }
    import silk.platform.native.host_input { NativeHostInput }
  }
  import silk.collections.bytes { Bytes }

  pub effect fn save(name: string, bytes: &[u8]) -> ()
    ! FileError | HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    run saveAllocated(name, bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  }

  effect fn saveAllocated(name: string, bytes: &[u8]) -> ()
    ! FileError | HostInputError | OutOfMemoryError
    ? &mut Allocator {
    // No concurrent code in this sample mutates the process environment.
    let cwd = run workingDirectory()
    let mut files = run OsFileSystem.makeBytes(Bytes.asSlice(&cwd))
    let root = run Path.root()
    let path = run Path.join(&root, name)
    run FileSystem.writeFile(&path, bytes) |> Effect.provideMut<FileSystem>(&mut files)
  }

  effect fn workingDirectory() -> Bytes
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let mut inputs = run WindowsHostInput.capture()
      let directory = run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
      // A launcher that passes an extended working directory (`\\?\C:\...`, as the standard
      // library's Windows process image does) gives a name OsFileSystem rejects as a root.
      let bytes = Bytes.asSlice(&directory)
      if bytes.length > 4 && bytes[0] == 92 && bytes[1] == 92 && bytes[2] == 63 && bytes[3] == 92 {
        if bytes.length > 8 && bytes[4] == 85 && bytes[5] == 78 && bytes[6] == 67 && bytes[7] == 92 {
          let mut share = run Bytes.copy(b"\\\\")
          run Bytes.append(&mut share, Slice.view(bytes, 8, bytes.length - 8))
          return move share
        }
        return run Bytes.copy(Slice.view(bytes, 4, bytes.length - 4))
      }
      return move directory
    } else {
      let snapshot = run unsafe NativeHostInput.environmentSnapshot()
      let mut inputs = OsHostInput.make(move snapshot)
      return run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
    }
  }
}
