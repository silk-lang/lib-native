import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.regex { Regex, RegexError, Match }
import silk.text.string { String, InvalidUtf8 }
import silk.num.usize
import silk.num.u8
import silk.text.format { Format }

pub fn text(bytes: &Bytes) -> string {
  return match move String.fromUtf8(Bytes.asSlice(bytes)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => { Intrinsic.trap("Expected UTF-8 source") }
  }
}
pub effect fn readText(root: &Path, name: string) -> String ! FileError | TaskError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, name)
  return match move String.fromBytes(run FileSystem.readFile(&path)) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => run Task.abort("Source is not UTF-8")
  }
}
pub effect fn save(root: &Path, name: string, content: string) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, name)
  run FileSystem.writeFileWithParents(&path, String.utf8Bytes(content))
}
pub effect fn decode<T: Schema>(value: string) -> T ! TaskError | OutOfMemoryError ? &mut Allocator {
  return run Effect.catch<SchemaError>(SchemaJson.decode<T>(String.utf8Bytes(value)), effect fn(error: SchemaError) -> T ! TaskError | OutOfMemoryError ? &mut Allocator {
    drop error
    return run Task.abort("Invalid automation JSON input")
  })
}
pub effect fn cat(parts: &[string]) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  let mut at: usize = 0
  while at < parts.length {
    run String.append(&mut result, parts[at])
    at = at + 1
  }
  return move result
}
pub fn sub(value: string, start: usize, end: usize) -> string { return String.slice(value, start, end - start) }
pub fn length(value: string) -> usize { return String.utf8Bytes(value).length }
pub fn group<'a>(found: &Match<'a>, index: usize) -> string<'a> {
  return match move found.group(index) {
    Option<string<'a>>.Some { value } => value
    Option<string<'a>>.None => ""
  }
}
pub effect fn search<'a>(pattern: string, value: string<'a>) -> Option<Match<'a>> ! TaskError | OutOfMemoryError ? &mut Allocator {
  return run Effect.catch<RegexError>(find<'a>(pattern, value), effect fn(error: RegexError) -> Option<Match<'a>> ! TaskError | OutOfMemoryError ? &mut Allocator {
    drop error
    return run Task.abort("Regular-expression syntax or resource limit")
  })
}
effect fn find<'a>(pattern: string, value: string<'a>) -> Option<Match<'a>> ! RegexError | OutOfMemoryError ? &mut Allocator {
  let compiled = run Regex.compile(pattern)
  return run Regex.find(&compiled, value)
}
pub effect fn index(value: string, needle: string) -> usize ! TaskError | OutOfMemoryError ? &mut Allocator {
  return match move String.find(value, needle) {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => run Task.abort("Required upstream syntax was not found")
  }
}
pub effect fn replace(value: string, needle: string, replacement: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  let mut rest = value
  while let Option<usize>.Some { value: at } = move String.find(rest, needle) {
    run String.append(&mut result, sub(rest, 0, at))
    run String.append(&mut result, replacement)
    rest = sub(rest, at + length(needle), length(rest))
  }
  run String.append(&mut result, rest)
  return move result
}
pub effect fn split(value: string, delimiter: string) -> List<String> ! OutOfMemoryError ? &mut Allocator {
  let mut result = List<String>.make()
  let mut rest = value
  while let Option<usize>.Some { value: at } = move String.find(rest, delimiter) {
    run result.append(run String.copy(sub(rest, 0, at)))
    rest = sub(rest, at + length(delimiter), length(rest))
  }
  run result.append(run String.copy(rest))
  return move result
}
pub effect fn join(values: &List<String>, separator: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  let items = values.asSlice()
  let mut at: usize = 0
  while at < items.length {
    if at != 0 { run result.append(separator) }
    run result.append(items[at].view())
    at = at + 1
  }
  return move result
}
pub fn contains(values: &List<String>, wanted: string) -> bool {
  let items = values.asSlice()
  let mut at: usize = 0
  while at < items.length {
    if items[at].view() == wanted { return true }
    at = at + 1
  }
  return false
}
pub effect fn unique(values: &mut List<String>, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
  if !contains(&values.*, value) { run values.append(run String.copy(value)) }
}
pub effect fn closing(value: string, start: usize, left: u8, right: u8) -> usize ! TaskError | OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut depth: usize = 0
  let mut at = start
  while at < bytes.length {
    if bytes[at] == left { depth = depth + 1 }
    if bytes[at] == right {
      depth = depth - 1
      if depth == 0 { return at }
    }
    at = at + 1
  }
  return run Task.abort("Unclosed upstream delimiter")
}
pub effect fn quoted(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = run String.copy("\"")
  let bytes = String.utf8Bytes(value)
  let mut at: usize = 0
  let mut start: usize = 0
  while at < bytes.length {
    let escape = if bytes[at] == 34 { "\\\"" } else if bytes[at] == 92 { "\\\\" } else if bytes[at] == 10 { "\\n" } else if bytes[at] == 13 { "\\r" } else if bytes[at] == 9 { "\\t" } else { "" }
    if escape != "" {
      run result.append(sub(value, start, at))
      run result.append(escape)
      start = at + 1
    }
    at = at + 1
  }
  run result.append(sub(value, start, at))
  run result.append("\"")
  return move result
}
pub effect fn printLine(value: string) -> () ! WriterError ? &mut Allocator {
  let mut writer = StdoutWriter.make()
  run Writer.writeAll(String.utf8Bytes(value)) |> Effect.provideMut<Writer>(&mut writer)
  run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut writer)
}
pub effect fn printCounts(expected: usize, entries: usize) -> () ! WriterError {
  let mut writer = StdoutWriter.make()
  run Format.display(&expected) |> Effect.provideMut<Writer>(&mut writer)
  run Writer.writeAll(b" / ") |> Effect.provideMut<Writer>(&mut writer)
  run Format.display(&expected) |> Effect.provideMut<Writer>(&mut writer)
  run Writer.writeAll(b" upstream public methods mapped; ") |> Effect.provideMut<Writer>(&mut writer)
  run Format.display(&entries) |> Effect.provideMut<Writer>(&mut writer)
  run Writer.writeAll(b" total API entries.\n") |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn sorted<'a>(values: &'a List<String>) -> List<string<'a>>
  ! OutOfMemoryError ? &mut Allocator {
  let mut views = List<string<'a>>.make()
  let source = values.asSlice()
  let mut index: usize = 0
  while index < source.length {
    run views.append(source[index].view())
    index = index + 1
  }
  run views.sort()
  return move views
}
