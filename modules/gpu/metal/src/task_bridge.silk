// SPDX-License-Identifier: MIT OR Apache-2.0
import task_support as S
import silk.collections.list { List }
import silk.cli.task { TaskError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.string { String }
import silk.num.usize

pub struct Parameter { pub name: String, pub silk: String, pub c: String, }
impl Schema for Parameter {}
pub struct Binding {
  pub owner: String,
  pub name: String,
  pub params: List<Parameter>,
  pub result: String,
  pub cresult: String,
  pub body: String,
  pub notes: String,
  pub rust: String,
}
impl Schema for Binding {}
pub effect fn parameter(name: string, silk: string, c: string) -> Parameter ! OutOfMemoryError ? &mut Allocator {
  return Parameter { name: run String.copy(name), silk: run String.copy(silk), c: run String.copy(c) }
}
pub effect fn binding(owner: string, name: string, params: List<Parameter>, result: string, cresult: string, body: string, notes: string, rust: string) -> Binding ! OutOfMemoryError ? &mut Allocator {
  return Binding { owner: run String.copy(owner), name: run String.copy(name), params: move params, result: run String.copy(result), cresult: run String.copy(cresult), body: run String.copy(body), notes: run String.copy(notes), rust: run String.copy(rust) }
}
pub effect fn load(root: &Path, name: string) -> List<Binding> ! TaskError | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let path = run S.cat(&["tools/", name, ".json"])
  let input = run S.readText(root, path.view())
  return run S.decode<List<Binding>>(input.view())
}
pub effect fn emit(root: &Path, module: string, bindings: &List<Binding>, helpers: string) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let header = "// SPDX-License-Identifier: MIT OR Apache-2.0\n// Derived from metal-rs, Copyright GFX developers.\n// Generated by the Silk generate task; edit tools/*.json or src/task_*.silk.\n"
  let records = if module == "core" { "CGSize" } else if module == "library" { "NSRange" } else if module == "device" { "MTLSize, MTLSizeAndAlign, MTLAccelerationStructureSizes" } else if module == "pipeline" { "MTLClearColor, MTLSize" } else { "MTLViewport, MTLScissorRect, VertexAmplificationViewMapping, MTLSize, MTLOrigin, MTLRegion, NSRange" }
  let mut silk = run S.cat(&[header, "\n// Unsafe raw Metal bindings. Callers establish object validity, API availability,\n// encoder state, synchronization, pointer extents and callback lifetimes.\nimport types { ", records, " }\n\n"])
  let mut native = run S.cat(&[header, "\n#import <Foundation/Foundation.h>\n#import <Metal/Metal.h>\n#import <QuartzCore/CAMetalLayer.h>\n#import <TargetConditionals.h>\n#import <dispatch/dispatch.h>\n#import <objc/message.h>\n#import <objc/runtime.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include \"types.h\"\n\n", if module == "library" { "static NSString *metal_library_string(const char *value) {\n    return value ? [NSString stringWithUTF8String:value] : nil;\n}\n\n" } else { "" }, helpers])
  let mut declarations = String.make()
  let mut api = run String.copy("[\n")
  let mut owners = List<String>.make()
  let methods = bindings.asSlice()
  let mut at: usize = 0
  while at < methods.length { run S.unique(&mut owners, methods[at].owner.view())
    at = at + 1 }
  if module == "library" {
    run S.unique(&mut owners, "IntersectionFunctionDescriptor")
    run S.unique(&mut owners, "Counter")
    run S.unique(&mut owners, "CommonCounter")
  }
  let classes = owners.asSlice()
  let mut class: usize = 0
  let mut apiCount: usize = 0
  while class < classes.length {
    let opening = run S.cat(&["pub struct ", classes[class].view(), " {}\nimpl ", classes[class].view(), " {\n"])
    run silk.append(opening.view())
    at = 0
    while at < methods.length {
      let item = &methods[at]
      if item.owner.view() == classes[class].view() {
        let symbol = run S.cat(&["metal_", item.owner.view(), "_", item.name.view()])
        let mut signature = String.make()
        let mut abi = String.make()
        let mut cparams = String.make()
        let mut arguments = String.make()
        let mut conversions = String.make()
        let mut callbacks = String.make()
        let params = item.params.asSlice()
        let mut p: usize = 0
        while p < params.length {
          let parameter = &params[p]
          if p != 0 { run signature.append(", ")
            run abi.append(", ")
            run cparams.append(", ")
            run arguments.append(", ") }
          let typed = run S.cat(&[parameter.name.view(), ": ", parameter.silk.view()])
          run signature.append(typed.view())
          let mut rawType = parameter.silk.view()
          if rawType == "bool" { rawType = "u8" }
          let raw = run S.cat(&[parameter.name.view(), ": ", rawType])
          run abi.append(raw.view())
          if String.contains(parameter.c.view(), "$") { let value = run S.replace(parameter.c.view(), "$", parameter.name.view())
            run cparams.append(value.view()) }
          else { let value = run S.cat(&[parameter.c.view(), " ", parameter.name.view()])
            run cparams.append(value.view()) }
          run arguments.append(parameter.name.view())
          if parameter.silk.view() == "bool" {
            run arguments.append("_abi")
            let conversion = run S.cat(&["    let mut ", parameter.name.view(), "_abi: u8 = 0\n    if ", parameter.name.view(), " {\n      ", parameter.name.view(), "_abi = 1\n    }\n"])
            run conversions.append(conversion.view())
          }
          if String.startsWith(parameter.silk.view(), "extern ") {
            if S.length(callbacks.view()) != 0 { run callbacks.append(", ") }
            let name = run S.quoted(parameter.name.view())
            run callbacks.append(name.view())
          }
          p = p + 1
        }
        if params.length == 0 { run cparams.append("void") }
        if S.length(item.notes.view()) != 0 { let note = run S.cat(&["  /// ", item.notes.view(), "\n"])
          run silk.append(note.view()) }
        let wrapper = run S.cat(&["  pub unsafe fn ", item.name.view(), "(", signature.view(), ") -> ", item.result.view(), " {\n", conversions.view(), "    ", if item.result.view() == "()" { "" } else { "return " }, "unsafe ", symbol.view(), "(", arguments.view(), ")", if item.result.view() == "bool" { " != 0" } else { "" }, "\n  }\n\n"])
        run silk.append(wrapper.view())
        if S.length(callbacks.view()) != 0 { let directive = run S.cat(&["@callbacks(", callbacks.view(), ")\n"])
          run declarations.append(directive.view()) }
        let mut rawResult = item.result.view()
        if rawResult == "bool" { rawResult = "u8" }
        let foreign = run S.cat(&["unsafe extern \"C\" fn ", symbol.view(), "(", abi.view(), ") -> ", rawResult, "\n"])
        run declarations.append(foreign.view())
        let bridge = run S.cat(&[item.cresult.view(), " ", symbol.view(), "(", cparams.view(), ") {\n    ", item.body.view(), "\n}\n\n"])
        run native.append(bridge.view())
        let rust = run S.quoted(item.rust.view())
        let name = run S.cat(&[module, ".", item.owner.view(), ".", item.name.view()])
        let target = run S.quoted(name.view())
        let notes = run S.quoted(item.notes.view())
        if apiCount != 0 { run api.append(",\n") }
        let entry = run S.cat(&["  {\n    \"rust\": ", rust.view(), ",\n    \"silk\": ", target.view(), ",\n    \"notes\": ", notes.view(), "\n  }"])
        run api.append(entry.view())
        apiCount = apiCount + 1
      }
      at = at + 1
    }
    run silk.append("}\n\n")
    class = class + 1
  }
  run silk.append(declarations.view())
  run api.append("\n]\n")
  let silkPath = run S.cat(&["src/", module, ".silk"])
  let nativePath = run S.cat(&["native/", module, ".m"])
  let apiPath = run S.cat(&["api/", module, ".json"])
  run S.save(root, silkPath.view(), silk.view())
  run S.save(root, nativePath.view(), native.view())
  run S.save(root, apiPath.view(), api.view())
}
