import silk.collections.list { List }
import silk.build.graph { Build, BuildError, Compilation, Deferred, Options }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileSystem, FileError }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

union Tasks {
  Build { pub options: Options },
  Run { pub options: Options, pub arguments: List<String> },
  Plan { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build the package")
      |> Command.flatten("options")
      |> Command.arg("arguments", Opt.about("Arguments passed to the program"))
  }
}

effect fn compilation(options: &Options) -> Compilation
  ! BuildError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let defaults = run Compilation.fromPackage(options)
  return run defaults.target(run Deferred<String>.value(run String.copy("wasm32-unknown-unknown")))
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! BuildError
      | TaskError
      | ProcessError
      | FileError
      | HostInputError
      | OutOfMemoryError
      | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Build { options } => {
        let selected = run compilation(&options)
        let graph = run (run Build.make()).add(move selected)
        drop run graph.compile()
      }
      Tasks.Run { options, arguments } => {
        let selected = run compilation(&options)
        let graph = run (run Build.make()).add(move selected)
        let built = run graph.compile()
        let values = arguments.asSlice()
        let mut forwarded = List<string>.make()
        let mut at: usize = 0
        while at < values.length {
          run forwarded.append(values[at].view())
          at = at + 1
        }
        run built.launch(forwarded.asSlice())
      }
      Tasks.Plan { options } => {
        let selected = run compilation(&options)
        let graph = run (run Build.make()).add(move selected)
        drop run graph.write()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
