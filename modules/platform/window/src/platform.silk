//! The interface every window backend implements.
//!
//! Silk interfaces dispatch statically, so an app is generic over `P: Platform` and picks
//! one backend type at its entry point, usually `native.NativePlatform`. Windows are named
//! by `WindowId` rather than by separate window objects, which keeps one owner for all
//! native state and lets the browser and native backends share one shape.
//!
//! The event loop belongs to the app:
//!
//! ```silk,ignore
//! while true {
//!   match move run platform.nextEvent(Wait.Forever) {
//!     Option<Event>.Some { value } => {
//!       match &value {
//!         Event.RequestFrame { window, targetTime } => { draw(window) }
//!         Event.QuitRequested => { break }
//!         _ => {}
//!       }
//!     }
//!     _ => {}
//!   }
//! }
//! ```
//!
//! Backends must keep delivering events while the system runs its own loops, such as a live
//! resize or an open menu, so `nextEvent` returns there too. The app draws inside that
//! call sequence exactly as it does otherwise.
import event { Event, Modifiers }
import keys { KeyCode }
import shell { Tray, Notification }
import clipboard { ClipboardEntry }
import menu { MenuBar, OpenDialog, SaveDialog }
import types {
  WindowId,
  DialogId,
  WindowOptions,
  WindowError,
  Wait,
  Cursor,
  CursorImage,
  ImeState,
  Appearance,
  RawSurface,
}
import silk.core.option { Option }
import silk.geometry.size { Size2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String, InvalidUtf8 }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.result { Result }

pub interface Platform {
  // Windows.

  effect fn openWindow(self: &mut Self, options: &WindowOptions<'_>) -> WindowId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator

  /// Closes the window at once. Later calls with its id do nothing.
  fn closeWindow(self: &mut Self, window: WindowId) -> ()

  /// The next event, waiting as `wait` allows. `None` when the wait ended without one.
  effect fn nextEvent(self: &mut Self, wait: Wait) -> Option<Event>
    ! OutOfMemoryError
    ? &mut Allocator

  /// Asks for one `Event.RequestFrame` for the window at the display's next refresh.
  /// Requests before that frame coalesce. Request again from the frame to animate.
  fn requestFrame(self: &mut Self, window: WindowId) -> ()

  /// The content area in logical points.
  fn contentSize(self: &Self, window: WindowId) -> Size2<f64>

  /// Device pixels per logical point.
  fn scaleFactor(self: &Self, window: WindowId) -> f64

  /// The native objects to create a GPU surface from. Size the surface to
  /// `contentSize * scaleFactor` device pixels.
  fn rawSurface(self: &Self, window: WindowId) -> RawSurface

  effect fn setTitle(self: &mut Self, window: WindowId, title: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator

  fn setContentSize(self: &mut Self, window: WindowId, size: Size2<f64>) -> ()

  fn setMinContentSize(self: &mut Self, window: WindowId, size: Size2<f64>) -> ()

  fn setVisible(self: &mut Self, window: WindowId, visible: bool) -> ()

  /// Brings the window to the front and gives it keyboard focus.
  fn focus(self: &mut Self, window: WindowId) -> ()

  fn minimize(self: &mut Self, window: WindowId) -> ()

  fn toggleFullScreen(self: &mut Self, window: WindowId) -> ()

  /// Moves the window with the mouse until the button is released; call it for the
  /// `MouseDown` of a custom title bar, while the button is still down. On macOS the second
  /// press of a double click zooms or minimizes the window instead, as the user's settings say.
  fn startWindowDrag(self: &mut Self, window: WindowId) -> ()

  /// Shows `cursor` over the window's content area. Systems without a cursor of their own for
  /// a keyword show a bundled image of it.
  fn setCursor(self: &mut Self, window: WindowId, cursor: Cursor) -> ()

  /// Shows `image` over the window's content area until the next `setCursor` or
  /// `setCursorImage`, as CSS `cursor: url(...)` does. False when this backend draws no custom
  /// cursors, or the image is empty or larger than 256 pixels a side; keep a keyword then.
  effect fn setCursorImage(self: &mut Self, window: WindowId, image: &CursorImage<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// What the input method needs. Call it when focus moves between text fields and when
  /// the caret moves, so the candidate window follows the caret.
  fn setIme(self: &mut Self, window: WindowId, ime: ImeState) -> ()

  // App.

  /// Replaces the menu bar.
  effect fn setMenuBar(self: &mut Self, bar: &MenuBar) -> () ! OutOfMemoryError ? &mut Allocator

  /// Opens a file dialog without blocking. `Event.DialogClosed` carries the result.
  effect fn openFileDialog(self: &mut Self, options: &OpenDialog<'_>) -> DialogId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator

  effect fn saveFileDialog(self: &mut Self, options: &SaveDialog<'_>) -> DialogId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator

  /// The clipboard's text, if it holds any.
  effect fn readClipboard(self: &mut Self) -> Option<String> ! OutOfMemoryError ? &mut Allocator

  effect fn writeClipboard(self: &mut Self, text: string) -> () ! OutOfMemoryError ? &mut Allocator

  /// The MIME types the clipboard holds now, of text/plain, text/html and image/png, in that
  /// order.
  effect fn clipboardTypes(self: &mut Self) -> List<String> ! OutOfMemoryError ? &mut Allocator {
    let mut types = List<String>.make()
    match move run self.readClipboard() {
      Option<String>.Some { value } => {
        drop value
        run types.append(run String.copy("text/plain"))
      }
      _ => {}
    }
    return move types
  }

  /// The clipboard's data as MIME type `mime`, none when it does not hold that type.
  effect fn readClipboardType(self: &mut Self, mime: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    if mime != "text/plain" { return Option<Bytes>.None }
    match move run self.readClipboard() {
      Option<String>.Some { value } => {
        let bytes = run Bytes.copy(String.utf8Bytes(value.view()))
        return Option<Bytes>.some(move bytes)
      }
      _ => {
        return Option<Bytes>.None
      }
    }
  }

  /// Replaces the clipboard with one item that has a representation per entry, so a copy
  /// with text and HTML is one write. Entries of types the clipboard does not map are left
  /// out.
  effect fn writeClipboardItem(self: &mut Self, entries: &[ClipboardEntry]) -> () ! OutOfMemoryError ? &mut Allocator {
    let mut i: usize = 0
    while i < entries.length {
      if entries[i].mime.view() == "text/plain" {
        match String.fromUtf8(entries[i].data.asSlice()) {
          Result<string, InvalidUtf8>.Success { value } => run self.writeClipboard(value)
          _ => {}
        }
        return ()
      }
      i = i + 1
    }
  }

  fn appearance(self: &Self) -> Appearance

  // The desktop.

  /// Shows the tray icon, or replaces the one shown. False when the system has no tray.
  effect fn setTray(self: &mut Self, tray: &Tray<'_>) -> bool ! OutOfMemoryError ? &mut Allocator

  fn removeTray(self: &mut Self) -> ()

  /// Sends `Event.GlobalShortcut` with `id` when the key with `code` is pressed with exactly
  /// `modifiers`, whichever app has focus. Registering `id` again replaces its shortcut. False
  /// when the system refused (another app holds the shortcut) or has no global shortcuts
  /// (Wayland, the browser).
  effect fn registerShortcut(self: &mut Self, id: u32, code: KeyCode, modifiers: Modifiers) -> bool
    ! OutOfMemoryError
    ? &mut Allocator

  fn unregisterShortcut(self: &mut Self, id: u32) -> ()

  /// Shows a notification and returns its id for `Event.NotificationClicked`, or 0 when it
  /// could not be shown.
  effect fn notify(self: &mut Self, notification: &Notification<'_>) -> u32
    ! OutOfMemoryError
    ? &mut Allocator

  /// Opens `menu` as a context menu at `x`, `y` (points in `window`'s content area), with its
  /// items at the top level and `begin`/`end` for submenus. It returns at once: a chosen item
  /// sends `Event.MenuAction`, a menu closed without a choice `Event.ContextMenuClosed`. False
  /// when the system has no context menus to show (Linux without a toolkit, the browser): the
  /// app draws its own in the window.
  effect fn showContextMenu(self: &mut Self, window: WindowId, x: f64, y: f64, menu: &MenuBar) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Puts `text` on the app's icon in the dock or taskbar, such as an unread count; "" takes
  /// it off. Windows shows numbers up to 99 (more as "99+") and a dot for other text; Linux
  /// docks that read the launcher entry API show numbers only. False when the system shows
  /// no badges.
  effect fn setBadge(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Shows progress on the app's icon in the dock or taskbar, `fraction` from 0 to 1; a
  /// negative fraction takes it off. False when the system shows no progress there.
  effect fn setProgress(self: &mut Self, fraction: f64) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Opens `url` with the system's handler for it: a web page in the default browser, a
  /// `mailto:` link in the mail app, a `file:` URL in the app for its type. False when the
  /// system has no way to open URLs or refused this one.
  effect fn openUrl(self: &mut Self, url: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Shows the file or folder at `path` selected in the system's file manager (Finder,
  /// Explorer). False when the system has no file manager to show it in.
  effect fn revealPath(self: &mut Self, path: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  /// Starts dragging the files at `paths` out of `window`, so another app (Finder, a mail
  /// draft, a terminal) can take them; call it while the mouse button is down, from the
  /// `MouseDown` or a `MouseMoved` after it. The system draws the dragged icons and the
  /// window gets a `MouseUp` when the drag ends. False when this backend cannot drag files
  /// out, or no button is down.
  effect fn startFileDrag(self: &mut Self, window: WindowId, paths: &[String]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }
}
