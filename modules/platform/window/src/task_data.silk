pub const BRIDGE_HEADER: string = "//! The C ABI of native/bridge.h, shared by the Windows, Linux and browser backends.\n//! Generated by silk task generate-bridge; do not edit.\n//!\n//! On Windows and Linux the functions come from the C bridge the program links; in a wasm32\n//! build they are imports from the \"window\" module, which browser/window-host.js provides.\n//! On other targets they are stubs, so `bridge` type-checks everywhere and\n//! `BridgePlatform.start` reports `Unsupported`.\nimport silk.core.ownership { Copy }\n\n/// `SilkWindowEvent` in bridge.h.\npub extern \"C\" struct RawEvent {\n  pub kind: u32,\n  pub window: u32,\n  pub code: u32,\n  pub named: u32,\n  pub modifiers: u32,\n  pub flags: u32,\n  pub count: u32,\n  pub phase: u32,\n  pub x: f64,\n  pub y: f64,\n  pub dx: f64,\n  pub dy: f64,\n  pub value: f64,\n  pub start: u64,\n  pub end: u64,\n}\n\nimpl Copy for RawEvent {}\n\nimpl RawEvent {\n  pub fn zero() -> RawEvent {\n    return RawEvent {\n      kind: 0,\n      window: 0,\n      code: 0,\n      named: 0,\n      modifiers: 0,\n      flags: 0,\n      count: 0,\n      phase: 0,\n      x: 0.0,\n      y: 0.0,\n      dx: 0.0,\n      dy: 0.0,\n      value: 0.0,\n      start: 0,\n      end: 0,\n    }\n  }\n}\n"

