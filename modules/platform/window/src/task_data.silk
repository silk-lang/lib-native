// Authoritative window ABI tables. Append enum members; never reorder them.
import silk.core.ownership { Copy }

pub struct KeyMapping { pub native: usize, pub code: string<'static> }
impl Copy for KeyMapping {}
pub struct NamedMapping { pub code: string<'static>, pub named: string<'static> }
impl Copy for NamedMapping {}
pub struct BridgeFunction { pub name: string<'static>, pub parameters: string<'static>, pub result: string<'static>, pub stub: string<'static> }
impl Copy for BridgeFunction {}

