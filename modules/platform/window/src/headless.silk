//! A backend with no display: windows are records, events come from the test that drives
//! it, and frames follow the same request rules as the native backends. Tests of code that
//! is generic over `Platform` run on it anywhere, including CI without a display.
import event { Event, Modifiers, MouseButton }
import keys { KeyCode }
import shell { Tray, Notification }
import clipboard { ClipboardEntry, CLIPBOARD_TYPES, supportsClipboardType }
import menu { MenuBar, MenuEntry, OpenDialog, SaveDialog }
import platform { Platform }
import types {
  WindowId,
  DialogId,
  WindowOptions,
  WindowError,
  Wait,
  Cursor,
  CursorImage,
  cursorImageFits,
  ImeState,
  Appearance,
  RawSurface,
}
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.point { Point2 }
import silk.geometry.size { Size2 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

/// What the headless platform remembers about one window.
pub struct HeadlessWindow {
  pub id: WindowId,
  pub open: bool,
  pub title: String,
  pub size: Size2<f64>,
  pub minSize: Size2<f64>,
  pub scaleFactor: f64,
  pub visible: bool,
  pub focused: bool,
  pub minimized: bool,
  pub fullScreen: bool,
  pub cursor: Cursor,
  /// The size and hot spot of the image `setCursorImage` showed last, 0 x 0 while `cursor`
  /// shows.
  pub cursorImageWidth: u32,
  pub cursorImageHeight: u32,
  pub cursorHotX: u32,
  pub cursorHotY: u32,
  pub ime: ImeState,
  /// A frame was requested and not yet delivered.
  pub framePending: bool,
  /// Frames delivered so far.
  pub frames: u64,
}

/// A shortcut registered with `registerShortcut`.
pub struct HeadlessShortcut {
  pub id: u32,
  pub code: KeyCode,
  pub modifiers: Modifiers,
}

impl Copy for HeadlessShortcut {}

/// A notification shown with `notify`.
pub struct HeadlessNotification {
  pub id: u32,
  pub title: String,
  pub body: String,
}

/// A context menu open from `showContextMenu`.
pub struct HeadlessContextMenu {
  pub window: WindowId,
  pub x: f64,
  pub y: f64,
  /// Items and submenus, counted as `menuItems` is.
  pub items: usize,
}

impl Copy for HeadlessContextMenu {}

pub struct HeadlessPlatform {
  windows: List<HeadlessWindow>,
  queue: List<Event>,
  clipboard: List<ClipboardEntry>,
  appearance: Appearance,
  nextDialog: u32,
  /// The seconds between display refreshes; `targetTime` advances by it per frame.
  pub refreshInterval: f64,
  time: f64,
  /// Menus and items in the last menu bar, counted through submenus.
  pub menuItems: usize,
  /// The tray's tooltip while a tray is shown.
  pub tray: Option<String>,
  /// Items in the tray's menu, counted as `menuItems` is.
  pub trayItems: usize,
  pub shortcuts: List<HeadlessShortcut>,
  /// Every notification shown, oldest first.
  pub notifications: List<HeadlessNotification>,
  /// The context menu open, if one is.
  pub contextMenu: Option<HeadlessContextMenu>,
  /// The badge on the app's icon; empty for none.
  pub badge: String,
  /// The progress on the app's icon; negative for none.
  pub progress: f64,
  /// Every URL opened and path revealed, oldest first.
  pub openedUrls: List<String>,
  pub revealedPaths: List<String>,
  /// The paths of the last file drag started.
  pub draggedFiles: List<String>,
}

impl HeadlessPlatform {
  /// The same entry point as the native backends, so `native.NativePlatform.start()` works
  /// on every target. It never fails.
  pub effect fn start() -> HeadlessPlatform
    ! WindowError {
    return HeadlessPlatform.make()
  }

  pub fn make() -> HeadlessPlatform {
    return HeadlessPlatform {
      windows: List<HeadlessWindow>.make(),
      queue: List<Event>.make(),
      clipboard: List<ClipboardEntry>.make(),
      appearance: Appearance.Light,
      nextDialog: 1,
      refreshInterval: 1.0 / 60.0,
      time: 0.0,
      menuItems: 0,
      tray: Option<String>.None,
      trayItems: 0,
      shortcuts: List<HeadlessShortcut>.make(),
      notifications: List<HeadlessNotification>.make(),
      contextMenu: Option<HeadlessContextMenu>.None,
      badge: String.make(),
      progress: -1.0,
      openedUrls: List<String>.make(),
      revealedPaths: List<String>.make(),
      draggedFiles: List<String>.make(),
    }
  }

  /// Queues an event as if the system had sent it.
  pub effect fn push(self: &mut Self, event: Event) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(move event)
  }

  /// Resizes the window as a user would: `Resized`, then a frame at the new size.
  pub effect fn resize(self: &mut Self, window: WindowId, size: Size2<f64>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let scaleFactor = self.scaleFactor(window)
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].size = size
      windows[value].framePending = true
    } else {
      return ()
    }
    run self.queue.append(Event.Resized { window: window, size: size, scaleFactor: scaleFactor })
  }

  /// Moves the window to a display with another scale factor.
  pub effect fn changeScaleFactor(self: &mut Self, window: WindowId, scaleFactor: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let size = self.contentSize(window)
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].scaleFactor = scaleFactor
      windows[value].framePending = true
    } else {
      return ()
    }
    run self.queue.append(Event.ScaleFactorChanged { window: window, scaleFactor: scaleFactor })
    run self.queue.append(Event.Resized { window: window, size: size, scaleFactor: scaleFactor })
  }

  /// Closes a dialog with the chosen paths; none means cancelled.
  pub effect fn closeDialog(self: &mut Self, dialog: DialogId, paths: List<String>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(Event.DialogClosed { dialog: dialog, paths: move paths })
  }

  /// Drags `paths` over the window and drops them at `position`, as a user would:
  /// `FileDragEntered`, `FileDragMoved`, then `FileDropped`.
  pub effect fn dropFiles(
    self: &mut Self,
    window: WindowId,
    position: Point2<f64>,
    paths: &[string],
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let entered = run HeadlessPlatform.copyPaths(paths)
    let dropped = run HeadlessPlatform.copyPaths(paths)
    run self.queue.append(
      Event.FileDragEntered { window: window, position: position, paths: move entered },
    )
    run self.queue.append(Event.FileDragMoved { window: window, position: position })
    run self.queue.append(
      Event.FileDropped { window: window, position: position, paths: move dropped },
    )
  }

  effect fn copyPaths(paths: &[string]) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut list = run List<String>.makeWithCapacity(paths.length)
    let mut i: usize = 0
    while i < paths.length {
      let path = run String.copy(paths[i])
      run list.append(move path)
      i = i + 1
    }
    return move list
  }

  /// Presses the registered shortcut `id`. False when no shortcut has that id.
  pub effect fn pressShortcut(self: &mut Self, id: u32) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.findShortcut(id) == self.shortcuts.length() {
      return false
    }
    run self.queue.append(Event.GlobalShortcut { id: id })
    return true
  }

  /// Clicks the tray icon. False when no tray is shown.
  pub effect fn clickTray(self: &mut Self, button: MouseButton) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if let Option<String>.None = &self.tray {
      return false
    }
    run self.queue.append(Event.TrayClicked { button: button })
    return true
  }

  /// Clicks the notification `id`.
  pub effect fn clickNotification(self: &mut Self, id: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.queue.append(Event.NotificationClicked { id: id })
  }

  /// Chooses the item with `action` in the open context menu, or closes it without a choice
  /// when `action` is None. False when no context menu is open.
  pub effect fn answerContextMenu(self: &mut Self, action: Option<u32>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let window = match Intrinsic.replace(self.contextMenu, Option<HeadlessContextMenu>.None) {
      Option<HeadlessContextMenu>.Some { value } => value.window
      Option<HeadlessContextMenu>.None => {
        return false
      }
    }
    match action {
      Option<u32>.Some { value } => {
        run self.queue.append(Event.MenuAction { action: value })
      }
      Option<u32>.None => {
        run self.queue.append(Event.ContextMenuClosed { window: window })
      }
    }
    return true
  }

  fn findShortcut(self: &Self, id: u32) -> usize {
    let shortcuts = self.shortcuts.asSlice()
    let mut i: usize = 0
    while i < shortcuts.length {
      if shortcuts[i].id == id {
        return i
      }
      i = i + 1
    }
    return shortcuts.length
  }

  pub fn setAppearance(self: &mut Self, appearance: Appearance) -> () {
    self.appearance = appearance
  }

  /// The window's record, while the window is open.
  pub fn window(self: &Self, window: WindowId) -> Option<&HeadlessWindow> {
    let value = self.find(window)
    if value < self.windows.length() {
      return Option<&HeadlessWindow>.some(&self.windows.asSlice()[value])
    }
    return Option<&HeadlessWindow>.None
  }

  /// Events queued and not yet returned by `nextEvent`.
  pub fn queued(self: &Self) -> usize {
    return self.queue.length()
  }

  /// The index of the open window, or the window count when it is not open.
  fn find(self: &Self, window: WindowId) -> usize {
    let windows = self.windows.asSlice()
    let mut i: usize = 0
    while i < windows.length {
      if windows[i].id.value == window.value && windows[i].open {
        return i
      }
      i = i + 1
    }
    return windows.length
  }

  fn newDialog(self: &mut Self) -> DialogId {
    let id = DialogId { value: self.nextDialog }
    self.nextDialog = self.nextDialog + 1
    return id
  }
}

impl Platform for HeadlessPlatform {
  effect fn openWindow(self: &mut Self, options: &WindowOptions<'_>) -> WindowId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    let id = WindowId { value: usize.toU32(self.windows.length()) + 1 }
    let minSize = match options.minSize {
      Option<Size2<f64>>.Some { value } => value
      _ => Size2<f64>.zero()
    }
    let title = run String.copy(options.title)
    run self.windows.append(
      HeadlessWindow {
        id: id,
        open: true,
        title: move title,
        size: options.size,
        minSize: minSize,
        scaleFactor: 1.0,
        visible: options.visible,
        focused: options.visible,
        minimized: false,
        fullScreen: false,
        cursor: Cursor.Arrow,
        cursorImageWidth: 0,
        cursorImageHeight: 0,
        cursorHotX: 0,
        cursorHotY: 0,
        ime: ImeState.disabled(),
        framePending: options.visible,
        frames: 0,
      },
    )
    if options.visible {
      run self.queue.append(Event.Resized { window: id, size: options.size, scaleFactor: 1.0 })
    }
    return id
  }

  fn closeWindow(self: &mut Self, window: WindowId) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].open = false
      windows[value].framePending = false
    }
  }

  effect fn nextEvent(self: &mut Self, wait: Wait) -> Option<Event>
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.queue.length() != 0 {
      return Option<Event>.some(self.queue.remove(0))
    }

    // One display refresh: every window with a pending request draws once.
    let windows = self.windows.asMutSlice()
    let mut i: usize = 0
    while i < windows.length {
      if windows[i].framePending && windows[i].open && windows[i].visible && !windows[i].minimized {
        windows[i].framePending = false
        windows[i].frames = windows[i].frames + 1
        self.time = self.time + self.refreshInterval
        return Option<Event>.some(
          Event.RequestFrame { window: windows[i].id, targetTime: self.time },
        )
      }
      i = i + 1
    }
    return Option<Event>.None
  }

  fn requestFrame(self: &mut Self, window: WindowId) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].framePending = true
    }
  }

  fn contentSize(self: &Self, window: WindowId) -> Size2<f64> {
    let value = self.find(window)
    if value < self.windows.length() {
      return self.windows.asSlice()[value].size
    }
    return Size2<f64>.zero()
  }

  fn scaleFactor(self: &Self, window: WindowId) -> f64 {
    let value = self.find(window)
    if value < self.windows.length() {
      return self.windows.asSlice()[value].scaleFactor
    }
    return 1.0
  }

  fn rawSurface(self: &Self, window: WindowId) -> RawSurface {
    return RawSurface.None
  }

  effect fn setTitle(self: &mut Self, window: WindowId, title: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = self.find(window)
    if value < self.windows.length() {
      let copy = run String.copy(title)
      let windows = self.windows.asMutSlice()
      windows[value].title = move copy
    }
  }

  fn setContentSize(self: &mut Self, window: WindowId, size: Size2<f64>) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].size = size
      windows[value].framePending = true
    }
  }

  fn setMinContentSize(self: &mut Self, window: WindowId, size: Size2<f64>) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].minSize = size
    }
  }

  fn setVisible(self: &mut Self, window: WindowId, visible: bool) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].visible = visible
      if visible {
        let windows = self.windows.asMutSlice()
        windows[value].framePending = true
      }
    }
  }

  fn focus(self: &mut Self, window: WindowId) -> () {
    let windows = self.windows.asMutSlice()
    let mut i: usize = 0
    while i < windows.length {
      windows[i].focused = windows[i].id.value == window.value
      i = i + 1
    }
  }

  fn minimize(self: &mut Self, window: WindowId) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].minimized = true
    }
  }

  fn toggleFullScreen(self: &mut Self, window: WindowId) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let record = &mut self.windows.asMutSlice()[value]
      record.fullScreen = !record.fullScreen
    }
  }

  fn startWindowDrag(self: &mut Self, window: WindowId) -> () {}

  fn setCursor(self: &mut Self, window: WindowId, cursor: Cursor) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].cursor = cursor
      windows[value].cursorImageWidth = 0
      windows[value].cursorImageHeight = 0
    }
  }

  effect fn setCursorImage(self: &mut Self, window: WindowId, image: &CursorImage<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let value = self.find(window)
    if value >= self.windows.length() || !cursorImageFits(image) {
      return false
    }
    let windows = self.windows.asMutSlice()
    windows[value].cursorImageWidth = image.width
    windows[value].cursorImageHeight = image.height
    windows[value].cursorHotX = image.hotX
    windows[value].cursorHotY = image.hotY
    return true
  }

  fn setIme(self: &mut Self, window: WindowId, ime: ImeState) -> () {
    let value = self.find(window)
    if value < self.windows.length() {
      let windows = self.windows.asMutSlice()
      windows[value].ime = ime
    }
  }

  effect fn setMenuBar(self: &mut Self, bar: &MenuBar) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.menuItems = countItems(bar)
  }

  effect fn openFileDialog(self: &mut Self, options: &OpenDialog<'_>) -> DialogId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    return self.newDialog()
  }

  effect fn saveFileDialog(self: &mut Self, options: &SaveDialog<'_>) -> DialogId
    ! WindowError | OutOfMemoryError
    ? &mut Allocator {
    return self.newDialog()
  }

  effect fn readClipboard(self: &mut Self) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    match move run self.readClipboardType("text/plain") {
      Option<Bytes>.Some { value } => {
        let text = run String.copy(unsafe String.fromUtf8Unchecked(value.asSlice()))
        return Option<String>.some(move text)
      }
      _ => {
        return Option<String>.None
      }
    }
  }

  effect fn writeClipboard(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let entry = ClipboardEntry { mime: run String.copy("text/plain"), data: run Bytes.copy(String.utf8Bytes(text)) }
    self.clipboard = List<ClipboardEntry>.make()
    run self.clipboard.append(move entry)
  }

  effect fn clipboardTypes(self: &mut Self) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut types = List<String>.make()
    let mut kind: usize = 0
    while kind < CLIPBOARD_TYPES.length {
      let name = CLIPBOARD_TYPES[kind]
      kind = kind + 1
      let mut i: usize = 0
      while i < self.clipboard.length() {
        if self.clipboard.asSlice()[i].mime.view() == name {
          run types.append(run String.copy(name))
          break
        }
        i = i + 1
      }
    }
    return move types
  }

  effect fn readClipboardType(self: &mut Self, mime: string) -> Option<Bytes>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut i: usize = 0
    while i < self.clipboard.length() {
      let entry = &self.clipboard.asSlice()[i]
      if entry.mime.view() == mime {
        let copy = run Bytes.copy(entry.data.asSlice())
        return Option<Bytes>.some(move copy)
      }
      i = i + 1
    }
    return Option<Bytes>.None
  }

  /// Keeps the entries of the types the clipboard maps, as a system clipboard would.
  effect fn writeClipboardItem(self: &mut Self, entries: &[ClipboardEntry]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.clipboard = List<ClipboardEntry>.make()
    let mut i: usize = 0
    while i < entries.length {
      if supportsClipboardType(entries[i].mime.view()) {
        let entry = ClipboardEntry { mime: run String.copy(entries[i].mime.view()), data: run Bytes.copy(entries[i].data.asSlice()) }
        run self.clipboard.append(move entry)
      }
      i = i + 1
    }
  }

  fn appearance(self: &Self) -> Appearance {
    return self.appearance
  }

  effect fn setTray(self: &mut Self, tray: &Tray<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let tooltip = run String.copy(tray.tooltip)
    self.tray = Option<String>.some(move tooltip)
    self.trayItems = countItems(tray.menu)
    return true
  }

  fn removeTray(self: &mut Self) -> () {
    self.tray = Option<String>.None
    self.trayItems = 0
  }

  effect fn registerShortcut(self: &mut Self, id: u32, code: KeyCode, modifiers: Modifiers) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let shortcut = HeadlessShortcut { id: id, code: code, modifiers: modifiers }
    let at = self.findShortcut(id)
    if at < self.shortcuts.length() {
      let shortcuts = self.shortcuts.asMutSlice()
      shortcuts[at] = shortcut
    } else {
      run self.shortcuts.append(shortcut)
    }
    return true
  }

  fn unregisterShortcut(self: &mut Self, id: u32) -> () {
    let at = self.findShortcut(id)
    if at < self.shortcuts.length() {
      drop self.shortcuts.remove(at)
    }
  }

  effect fn notify(self: &mut Self, notification: &Notification<'_>) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = usize.toU32(self.notifications.length()) + 1
    let title = run String.copy(notification.title)
    let body = run String.copy(notification.body)
    run self.notifications.append(
      HeadlessNotification { id: id, title: move title, body: move body },
    )
    return id
  }

  effect fn showContextMenu(self: &mut Self, window: WindowId, x: f64, y: f64, menu: &MenuBar) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.find(window) >= self.windows.length() {
      return false
    }
    // A menu opened over an open one replaces it, which closes it without a choice.
    drop run self.answerContextMenu(Option<u32>.None)
    self.contextMenu = Option<HeadlessContextMenu>.some(
      HeadlessContextMenu { window: window, x: x, y: y, items: countItems(menu) },
    )
    return true
  }

  effect fn setBadge(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    self.badge = run String.copy(text)
    return true
  }

  effect fn setProgress(self: &mut Self, fraction: f64) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    self.progress = if fraction < 0.0 { -1.0 } else if fraction > 1.0 { 1.0 } else { fraction }
    return true
  }

  effect fn openUrl(self: &mut Self, url: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.openedUrls.append(run String.copy(url))
    return true
  }

  effect fn revealPath(self: &mut Self, path: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.revealedPaths.append(run String.copy(path))
    return true
  }

  effect fn startFileDrag(self: &mut Self, window: WindowId, paths: &[String]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut copied = List<String>.make()
    let mut i: usize = 0
    while i < paths.length {
      run copied.append(run String.copy(String.view(&paths[i])))
      i = i + 1
    }
    self.draggedFiles = move copied
    return paths.length > 0
  }
}

/// Menus and items, counted through submenus.
fn countItems(bar: &MenuBar) -> usize {
  let entries = bar.entries.asSlice()
  let mut count: usize = 0
  let mut i: usize = 0
  while i < entries.length {
    match &entries[i] {
      MenuEntry.End => {}
      _ => {
        count = count + 1
      }
    }
    i = i + 1
  }
  return count
}
