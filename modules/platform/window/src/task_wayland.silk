import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.effect { Effect }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.usize
import task_codegen { path, text }
import task_build { capture }

pub effect fn generate() -> () ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let mut share = run String.copy("/usr/share/wayland-protocols")
  let captured = run Effect.result(capture("pkg-config", &["--variable=pkgdatadir", "wayland-protocols"]))
  match move captured {
    Result<Bytes, TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError>.Success { value } => {
      let found = run text(&value)
      share = run String.copy(String.trim(String.view(&found)))
    }
    Result<Bytes, TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError>.Failure { error } => { drop error }
  }
  let protocols = ["stable/xdg-shell/xdg-shell.xml", "unstable/xdg-decoration/xdg-decoration-unstable-v1.xml", "unstable/text-input/text-input-unstable-v3.xml", "staging/fractional-scale/fractional-scale-v1.xml", "stable/viewporter/viewporter.xml", "staging/cursor-shape/cursor-shape-v1.xml", "stable/tablet/tablet-v2.xml"]
  let names = ["xdg-shell", "xdg-decoration-unstable-v1", "text-input-unstable-v3", "fractional-scale-v1", "viewporter", "cursor-shape-v1", "tablet-v2"]
  let directory = run Path.make(String.view(&share))
  let output = run path("native/linux/protocols")
  run FileSystem.createDirectoriesRecursively(&output)
  let mut i: usize = 0
  while i < protocols.length {
    let mut xml = run Path.join(&directory, protocols[i])
    let mut name = names[i]
    if i == 6 && !run FileSystem.exists(&xml) {
      xml = run Path.join(&directory, "unstable/tablet/tablet-unstable-v2.xml")
      name = "tablet-unstable-v2"
    }
    if !run FileSystem.exists(&xml) { run Task.abort(protocols[i]) }
    let mut j: usize = 0
    while j < 2 {
      let mut destinationName = run String.copy("native/linux/protocols/")
      run String.append(&mut destinationName, name)
      run String.append(&mut destinationName, if j == 0 { "-client-protocol.h" } else { "-protocol.c" })
      let xmlText = match move Path.view(&xml) {
        Option<string>.Some { value } => value
        Option<string>.None => run Task.abort("protocol path is not UTF-8")
      }
      run Task.exec("wayland-scanner", &[if j == 0 { "client-header" } else { "private-code" }, xmlText, String.view(&destinationName)])
      let destination = run path(String.view(&destinationName))
      let bytes = run FileSystem.readFile(&destination)
      let contents = run text(&bytes)
      let mut lines = String.split(String.view(&contents), "\n")
      let mut filtered = run String.copy("")
      let mut first = true
      while true {
        match move lines.next() {
          Option<string>.Some { value } => {
            if !String.startsWith(value, "/* Generated by wayland-scanner") {
              if !first { run String.append(&mut filtered, "\n") }
              run String.append(&mut filtered, value)
              first = false
            }
          }
          Option<string>.None => { break }
        }
      }
      run FileSystem.writeFile(&destination, String.utf8Bytes(String.view(&filtered)))
      j = j + 1
    }
    i = i + 1
  }
}
